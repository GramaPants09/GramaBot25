# GramaBot25 environment — copy to .env and fill in. Only DISCORD_API is required;
# every other key is optional and the matching feature degrades gracefully without it.

# --- Required ---
DISCORD_API=your-discord-bot-token

# --- Brain ---
# Pick ONE provider. Leave BRAIN_PROVIDER unset to auto-detect from whichever
# key is present (Anthropic wins if both are set).
# BRAIN_PROVIDER=openrouter      # or: anthropic

# Option A) OpenRouter — one key for many models (Claude, Grok, GPT, free models).
OPEN_ROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=x-ai/grok-4.20            # any tool-capable OpenRouter model
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # free default

# Option B) Anthropic direct (metered key).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6          # default; claude-haiku-4-5 = near-free
# NOTE: you CANNOT run this off a Claude Pro/Max subscription — Anthropic blocks
# third-party apps from using subscription auth. A metered key is required.

# --- Butcher voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # the voice you build in ElevenLabs
# ELEVENLABS_MODEL=eleven_flash_v2_5
# EDGE_TTS_VOICE=en-GB-RyanNeural   # fallback voice when ElevenLabs is unset/down

# --- Voice listening (STT) ---
# STT_BACKEND=whisper        # whisper | deepgram | google
# WHISPER_MODEL=small        # tiny|base|small|medium|large-v3
# WHISPER_COMPUTE=int8       # int8 (CPU) | int8_float16 (GPU)
# DEEPGRAM_API_KEY=          # only if STT_BACKEND=deepgram

# --- Spotify (music links) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OpenClaw gateway (optional agent ability) ---
# OPENCLAW_WS_URL=ws://127.0.0.1:18789
# OPENCLAW_TOKEN=

# --- Misc existing ---
TENOR_KEY=                  # $gif command
# BRAVE_API_KEY=            # enables the web_search tool
